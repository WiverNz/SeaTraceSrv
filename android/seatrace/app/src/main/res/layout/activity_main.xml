<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Full-screen map -->
    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:maplibre_cameraTargetLat="55.0"
        app:maplibre_cameraTargetLng="15.0"
        app:maplibre_cameraZoom="4.5" />

    <!-- Connection status bar (hidden when connected) -->
    <LinearLayout
        android:id="@+id/statusBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@color/status_bar_background"
        android:gravity="center"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:visibility="gone">

        <TextView
            android:id="@+id/statusText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/status_bar_text"
            android:textSize="12sp" />

    </LinearLayout>

    <!-- Attribution notice (required by OSM/OpenSeaMap licenses) -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="8dp"
        android:layout_marginBottom="8dp"
        android:alpha="0.85"
        android:background="@color/attribution_background"
        android:paddingHorizontal="4dp"
        android:paddingVertical="2dp"
        android:text="@string/attribution"
        android:textColor="@color/attribution_text"
        android:textSize="10sp" />

    <!-- FABs — bottom-right stack -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="16dp"
        android:layout_marginBottom="16dp"
        android:orientation="vertical"
        android:gravity="end">

        <!-- Layers toggle -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLayers"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:contentDescription="@string/fab_layers_desc"
            app:srcCompat="@drawable/ic_layers"
            app:fabSize="mini"
            app:backgroundTint="@color/fab_background"
            app:tint="@color/fab_icon" />

        <!-- Locate me -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabLocation"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/fab_location_desc"
            app:srcCompat="@drawable/ic_my_location"
            app:fabSize="normal"
            app:backgroundTint="@color/fab_background"
            app:tint="@color/fab_icon" />

    </LinearLayout>

</androidx.coordinatorlayout.widget.CoordinatorLayout>

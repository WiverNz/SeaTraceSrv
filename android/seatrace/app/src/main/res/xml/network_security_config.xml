<?xml version="1.0" encoding="utf-8"?>
<!--
    Allow cleartext (ws://) to the Android emulator host alias only.
    Production traffic to real servers must use wss://.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="true">asgard</domain>
    </domain-config>
</network-security-config>

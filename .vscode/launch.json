{
    // https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        // ── Run ──────────────────────────────────────────────────────────────
        {
            "name": "Run seatracesrv",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=seatracesrv",
                    "--package=seatracesrv"
                ]
            },
            "program": "${workspaceFolder}/target/debug/seatracesrv",
            "args": [],
            "envFile": "${workspaceFolder}/.env"
        },
        // ── Debug ─────────────────────────────────────────────────────────────
        {
            "name": "Debug seatracesrv",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "build",
                    "--bin=seatracesrv",
                    "--package=seatracesrv"
                ]
            },
            "program": "${workspaceFolder}/target/debug/seatracesrv",
            "args": [],
            "envFile": "${workspaceFolder}/.env",
            "sourceLanguages": [
                "rust"
            ]
        },
        // ── Python Client ────────────────────────────────────────────────────
        {
            "name": "Python Client: Stream",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/client.py",
            "args": ["stream", "--host", "asgard.fritz.box", "--port", "8080"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Client: Stream (localhost)",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/client.py",
            "args": ["stream", "--host", "localhost", "--port", "8080"],
            "console": "integratedTerminal"
        },
        {
            "name": "Python Client: Health Check",
            "type": "debugpy",
            "request": "launch",
            "program": "${workspaceFolder}/scripts/client.py",
            "args": ["health", "--host", "asgard.fritz.box", "--port", "8080"],
            "console": "integratedTerminal"
        },
        // ── Integration Tests ─────────────────────────────────────────────────
        {
            "name": "Test: BDD subscriptions (cucumber)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--test=cucumber",
                    "--package=integration-tests"
                ]
            },
            "args": [
                "--nocapture"
            ]
        },
        {
            "name": "Test: BDD WebSocket API (ws_cucumber)",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--test=ws_cucumber",
                    "--package=integration-tests"
                ]
            },
            "args": [
                "--nocapture"
            ]
        },
        {
            "name": "Test: E2E Real AISStream Data",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--test=e2e_real_data",
                    "--package=integration-tests"
                ]
            },
            "args": [
                "--ignored",
                "--nocapture"
            ],
            "envFile": "${workspaceFolder}/.env"
        },
        {
            "name": "Test: All integration-tests",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=integration-tests"
                ]
            },
            "args": [
                "--nocapture"
            ]
        },
        // ── Android SDK Tests ─────────────────────────────────────────────────
        {
            "name": "Android SDK: Integration Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/seatrace-sdk-android/gradlew",
            "runtimeArgs": [":sdk:connectedAndroidTest"],
            "cwd": "${workspaceFolder}/seatrace-sdk-android",
            "console": "integratedTerminal"
        },
        {
            "name": "Android SDK: Build",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/seatrace-sdk-android/gradlew",
            "runtimeArgs": [":sdk:assembleDebug"],
            "cwd": "${workspaceFolder}/seatrace-sdk-android",
            "console": "integratedTerminal"
        },
        {
            "name": "Android SDK: Unit Tests",
            "type": "node",
            "request": "launch",
            "runtimeExecutable": "${workspaceFolder}/seatrace-sdk-android/gradlew",
            "runtimeArgs": [":sdk:testDebugUnitTest"],
            "cwd": "${workspaceFolder}/seatrace-sdk-android",
            "console": "integratedTerminal"
        },
        // ── Per-crate unit tests ──────────────────────────────────────────────
        {
            "name": "Test: core-model",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=core-model"
                ]
            }
        },
        {
            "name": "Test: connectors",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=connectors"
                ]
            }
        },
        {
            "name": "Test: delivery",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=delivery"
                ]
            }
        },
        {
            "name": "Test: aggregator",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=aggregator"
                ]
            }
        },
        {
            "name": "Test: data-store",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=data-store"
                ]
            }
        },
        {
            "name": "Test: control-api",
            "type": "lldb",
            "request": "launch",
            "cargo": {
                "args": [
                    "test",
                    "--package=control-api"
                ]
            }
        }
    ]
}